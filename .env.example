# Variables de entorno para Keeper
# Copia este archivo como .env y completa tus valores. El .env real no va al repositorio.

# Base de datos principal de Keeper (el contenedor MariaDB del compose)
DB_HOST=mariadb
DB_PORT=3306
DB_USER=keeper_user
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_NAME=keeper

# Base externa de solo lectura: técnicos, OLTS y contratos internos (poolExterna).
# En local puede ser el esquema de database/externa/empresa_externa.sql; para una base real de
# otra empresa basta con cambiar estas cinco variables y recrear el backend
# (docker compose up -d backend).
DB_EXTERNA_HOST=mariadb
DB_EXTERNA_PORT=3306
DB_EXTERNA_USER=externa_user
DB_EXTERNA_PASSWORD=
DB_EXTERNA_NAME=empresa_externa

# Backend
PORT=3000
NODE_ENV=development

# Minutos de inactividad antes de cerrar una sesión (por defecto 180)
SESSION_INACTIVITY_MINUTES=180

# URL del backend que usa el frontend
VITE_API_URL=http://localhost:3210

# Usuario administrador que el backend crea al arrancar si no existe (opcional, tiene valores por defecto)
# DEFAULT_USER_USERNAME=
# DEFAULT_USER_EMAIL=
# DEFAULT_USER_PASSWORD=
# DEFAULT_USER_NAME=
